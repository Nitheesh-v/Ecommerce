# ---------------------------------------------------------------------------
# Backend environment variables (copy to .env — never commit .env)
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# Allowed browser origins for CORS, comma separated
FRONTEND_URL=http://localhost:3000

# Expose Swagger UI at /api/docs. Defaults to true outside production.
SWAGGER_ENABLED=true

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# Rate limiting: THROTTLE_LIMIT requests per THROTTLE_TTL seconds, per IP per route
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Authentication (Phase 4) -------------------------------------------------
# Signing secret for access tokens. REQUIRED, minimum 32 characters.
# Generate one per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Access token lifetime; refresh sessions are opaque tokens (no secret needed)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor (production default 12; tests use 4)
BCRYPT_ROUNDS=12

# One-off credentials for `npm run seed:admin` — remove after seeding
# (`npm run seed:categories` needs no variables of its own)
# SEED_ADMIN_EMAIL=owner@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FIRST_NAME=Store
# SEED_ADMIN_LAST_NAME=Owner

# --- Product images (Phase 6) --------------------------------------------------
# Local disk storage (default). Files are served read-only from /uploads/<file>.
# Relative to the backend directory; gitignored.
UPLOAD_DIR=uploads

# Cloudinary (optional). Set ALL THREE to store images on the CDN instead of disk;
# leave all three empty for local storage. A partially-filled set aborts boot.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Online payments (Phase 11 · Razorpay) -------------------------------------
# Set ALL THREE to enable online checkout; leave all three empty to run without a
# gateway (admin payment views still work, checkout answers 503).
#
# Use TEST MODE keys while developing: they start with `rzp_test_` and move no real
# money. A live key pair belongs in the production environment only.
#
#   RAZORPAY_KEY_ID        dashboard → Account & Settings → API Keys (public; sent
#                          to the browser as the checkout key)
#   RAZORPAY_KEY_SECRET    same screen, revealed once (server-only)
#   RAZORPAY_WEBHOOK_SECRET  dashboard → Webhooks → your endpoint's secret
#
# Webhook URL to register in the Razorpay dashboard:
#   https://<your-api-host>/api/payments/webhook
# Events: payment.authorized, payment.captured, payment.failed,
#         refund.processed, refund.failed (order.paid is recorded but not acted on)
# NEVER commit real keys, and never put the secret in a NEXT_PUBLIC_ variable.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Courier partners (Phase 12 · shipping) ------------------------------------
# SHIPPING WORKS WITH NO CREDENTIALS. Leave everything below empty and the store
# runs the manual courier workflow: an admin assigns the partner, types the AWB
# and records each scan by hand. No tracking update is ever invented.
#
# A provider becomes selectable only when ALL of its variables are present. A
# partially-filled set aborts boot with the missing variable named, and the
# console lists the partner as unavailable instead of pretending to book it.
#
# There is NO courier webhook endpoint in this phase: statuses are entered by an
# operator (or later by a provider adapter), never posted by an unauthenticated
# caller.
#
#   Shiprocket   dashboard → Settings → API → Users
#                SHIPROCKET_EMAIL, SHIPROCKET_PASSWORD
#   Delhivery    dashboard → Settings → API token
#                DELHIVERY_API_TOKEN
#   Blue Dart    account manager / API portal
#                BLUEDART_API_KEY, BLUEDART_LICENCE_KEY
#
# SHIPROCKET_EMAIL=ops@example.com
# SHIPROCKET_PASSWORD=
# DELHIVERY_API_TOKEN=
# BLUEDART_API_KEY=
# BLUEDART_LICENCE_KEY=

# --- Optional: outbound email (Notifications, phase 18) ---
#
# Without these the store still records every notification in-app; the email half of
# each one is stored with status `skipped` and a reason, and the console says so. With
# them, transactional mail (order received/confirmed/shipped/delivered, payment failed,
# refund issued, low stock, welcome) is delivered over SMTP and every attempt is
# recorded with its outcome.
#
# SMTP_HOST and MAIL_FROM must be set together: an SMTP client with no envelope sender
# fails at the first real send instead of at boot. SMTP_USER/SMTP_PASSWORD are optional
# (both or neither) for relays that do not authenticate. SMTP_SECURE defaults to true
# when SMTP_PORT is 465.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=
# MAIL_FROM=orders@example.com

# --- Reserved for later phases (do not fill in until the phase that needs them) ---
# COOKIE_DOMAIN=localhost
# REDIS_URL=redis://127.0.0.1:6379
