# ---------------------------------------------------------------------------
# Backend environment variables (copy to .env — never commit .env)
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# Allowed browser origins for CORS, comma separated
FRONTEND_URL=http://localhost:3000

# Expose Swagger UI at /api/docs. Defaults to true outside production.
SWAGGER_ENABLED=true

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# Rate limiting: THROTTLE_LIMIT requests per THROTTLE_TTL seconds, per IP per route
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Token lifetimes (secrets are added in Phase 4 — never commit them)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Reserved for later phases (do not fill in until the phase that needs them) ---
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# COOKIE_DOMAIN=localhost
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# REDIS_URL=redis://127.0.0.1:6379
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
